    "vercel_deployment": {
      "role": "child",
      "category": "compute",
      "parent_attr": "project_id"
    },
    "vercel_project_domain": {
      "role": "child",
      "category": "network",
      "parent_attr": "project_id"
    },
    "vercel_project_environment_variable": {
      "role": "child",
      "category": "other",
      "parent_attr": "project_id"
    },
    "vercel_project_environment_variables": {
      "role": "child",
      "category": "other",
      "parent_attr": "project_id"
    },
    "vercel_project_crons": {
      "role": "child",
      "category": "compute",
      "parent_attr": "project_id"
    },
    "vercel_firewall_config": {
      "role": "child",
      "category": "security",
      "parent_attr": "project_id"
    },
    "vercel_edge_config": {
      "role": "primary",
      "category": "database",
      "label": "Edge Config"
