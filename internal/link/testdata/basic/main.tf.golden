resource "aws_iam_role" "app_lambda" {
  assume_role_policy = jsonencode({
    Statement = [{
      Action = "sts:AssumeRole"
      Effect = "Allow"
      Principal = {
        Service = "lambda.amazonaws.com"
      }
    }]
    Version = "2012-10-17"
  })
  name = "app-lambda"
  path = "/"
  tags = {
    Name = "app-lambda"
  }
}

resource "aws_iam_role_policy_attachment" "app_lambda_basic" {
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
  role       = aws_iam_role.app_lambda.name
}

resource "aws_iam_role_policy" "app_lambda_sqs" {
  name = "sqs"
  policy = jsonencode({
    Statement = [{
      Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage"]
      Effect   = "Allow"
      Resource = aws_sqs_queue.jobs.arn
      }, {
      Action   = "logs:PutLogEvents"
      Effect   = "Allow"
      Resource = ["${aws_cloudwatch_log_group.aws_lambda_app.arn}:*", "arn:aws:logs:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/lambda/app-other:*"]
    }]
    Version = "2012-10-17"
  })
  role = aws_iam_role.app_lambda.name
}

resource "aws_sqs_queue" "jobs" {
  name                       = "jobs"
  visibility_timeout_seconds = 30
}

resource "aws_cloudwatch_log_group" "aws_lambda_app" {
  name              = "/aws/lambda/app"
  retention_in_days = 14
}

resource "aws_lambda_function" "app" {
  function_name = "app"
  handler       = "index.handler"
  role          = aws_iam_role.app_lambda.arn
  runtime       = "nodejs22.x"
  vpc_config {
    security_group_ids = [aws_security_group.a.id]
    subnet_ids         = ["subnet-0bbbbbbbbbbbbbbbb"]
  }
}

resource "aws_lambda_event_source_mapping" "app_jobs" {
  batch_size       = 10
  event_source_arn = aws_sqs_queue.jobs.arn
  function_name    = aws_lambda_function.app.arn
}

resource "aws_security_group" "a" {
  name   = "a"
  vpc_id = "vpc-0ccccccccccccccc0"
  ingress = [{
    cidr_blocks     = []
    from_port       = 443
    protocol        = "tcp"
    security_groups = [aws_security_group.b.id]
    self            = false
    to_port         = 443
  }]
}

resource "aws_security_group" "b" {
  name   = "b"
  vpc_id = "vpc-0ccccccccccccccc0"
  ingress = [{
    cidr_blocks     = []
    from_port       = 5432
    protocol        = "tcp"
    security_groups = ["sg-0aaaaaaaaaaaaaaaa"]
    self            = false
    to_port         = 5432
  }]
}

resource "aws_s3_bucket" "data" {
  bucket = "data-bucket"
}

resource "aws_s3_bucket_policy" "data" {
  bucket = aws_s3_bucket.data.bucket
  policy = jsonencode({
    Statement = [{
      Action = "s3:GetObject"
      Effect = "Allow"
      Principal = {
        AWS = aws_iam_role.app_lambda.arn
      }
      Resource = "${aws_s3_bucket.data.arn}/*"
    }]
    Version = "2012-10-17"
  })
}

resource "aws_ecs_task_definition" "web" {
  family = "web"
  container_definitions = jsonencode([{
    image = "${data.aws_caller_identity.current.account_id}.dkr.ecr.${data.aws_region.current.region}.amazonaws.com/web:latest"
    logConfiguration = {
      logDriver = "awslogs"
      options = {
        awslogs-group  = aws_cloudwatch_log_group.aws_lambda_app.name
        awslogs-region = data.aws_region.current.region
      }
    }
    name = "web"
  }])
  execution_role_arn = aws_iam_role.app_lambda.arn
}

# --- data.tf ---
data "aws_caller_identity" "current" {}
data "aws_region" "current" {}
